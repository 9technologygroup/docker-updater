<mxfile host="app.diagrams.net" type="device">
  <diagram name="dup architecture" id="dup-arch">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="host" value="One Docker host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffef7;strokeColor=#a86a14;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="900" height="280" as="geometry" />
        </mxCell>

        <mxCell id="webhook" value="Webhook&#10;n8n, GitHub release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f2;strokeColor=#66757e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="dup CLI&#10;over loopback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f2;strokeColor=#66757e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dup" value="&lt;b&gt;dup&lt;/b&gt;&#10;unprivileged&#10;&#10;runs as the dup account&#10;no Docker access at all&#10;API, auth, jobs, scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2efee;strokeColor=#0d6b68;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="socket" value="unix socket&#10;0660 root:dup&#10;SO_PEERCRED checked" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#a86a14;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="140" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;dup-agent&lt;/b&gt;&#10;root&#10;&#10;no network listener&#10;docker compose&#10;health checks, rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e6e2;strokeColor=#a03020;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="stacks" value="Your Compose stacks&#10;/opt/app, /opt/db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f3f4f2;strokeColor=#66757e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1270" y="130" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="notify" value="Discord, n8n&#10;outbound notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f2;strokeColor=#66757e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1270" y="330" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTPS, bearer or HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#66757e;" edge="1" parent="1" source="webhook" target="dup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="HTTPS, bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#66757e;" edge="1" parent="1" source="cli" target="dup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="the only crossing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#a86a14;strokeWidth=2;" edge="1" parent="1" source="dup" target="socket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#a86a14;strokeWidth=2;" edge="1" parent="1" source="socket" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="pull, up, health, rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#a03020;" edge="1" parent="1" source="agent" target="stacks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="job result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#66757e;" edge="1" parent="1" source="dup" target="notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="The unprivileged half never touches Docker.&#10;The privileged half never listens on the network." style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#66757e;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="420" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
